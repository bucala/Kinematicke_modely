<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>KinematikaStudio</AssemblyName>
    <KinmoVersion Condition="'$(KinmoVersion)' == ''">2.1.0</KinmoVersion>
    <Version>$(KinmoVersion)</Version>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="web.zip" LogicalName="Kinematika.Web.zip" /></ItemGroup>
  <Target Name="RemoveUnusedWpfWebView" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup><Reference Remove="@(Reference->WithMetadataValue('Filename', 'Microsoft.Web.WebView2.Wpf'))" /></ItemGroup>
  </Target>
</Project>
